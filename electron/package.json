{
  "name": "unifiedai",
  "version": "1.0.0",
  "description": "UnifiedAi - The Ultimate Meta-Intelligence Platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "UnifiedAi",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.unifiedai.app",
    "productName": "UnifiedAi",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "loading.html"],
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"] },
      { "from": "../frontend", "to": "frontend" }
    ],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
