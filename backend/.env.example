# UnifiedAi backend - copy to .env and adjust

# Port (default 10000)
# BACKEND_PORT=10000

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_API_KEY=

# Arena model overrides (optional; defaults are cloud-safe)
# ARENA_MODEL_ANALYST=qwen3-coder:480b-cloud
# ARENA_MODEL_CREATIVE=gpt-oss:120b-cloud
# ARENA_MODEL_CRITIC=deepseek-v3.1:671b-cloud
# ARENA_MODEL_EMPATHIST=mistral-large-3:675b-cloud
# ARENA_MODEL_DIRECTOR=mistral-large-3:675b-cloud

# ActivatePrimeCOMPLETE relics - path to the data folder so UnifiedAi can use it as context
# Examples:
#   G:\ActivatePrimeCOMPLETE\data
#   G:\ActivatePrimeCOMPLETE\Activate_relics
#   C:\Users\You\ActivatePrimeCOMPLETE\data
ACTIVATEPRIME_RELICTS_PATH=
